# uv-managed environment: 7.3 GB, rebuilt with `uv sync`
.venv/

__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# local tool settings, not project config
.claude/

# training logs are regenerated; figures and their source data are committed
results/train_*.jsonl

# ~1 GB per arm
checkpoints/

# Chrome traces from experiments/profile_runtime.py: 100-150 MB each, over
# GitHub's file limit, and regenerable. The summary.json and operators.txt
# beside them are the readable output and are kept.
results/runtime_profile_*/*.trace.json
